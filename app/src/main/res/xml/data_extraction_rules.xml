<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. See backup_rules.xml for why sharedpref is excluded wholesale. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
