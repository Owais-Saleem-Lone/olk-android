<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon: the blue library-and-book mark with "OLK", the same as the Play Store icon
     (source: docs/app-icon.svg), inside the adaptive-icon safe circle, on white. The round
     OLK badge stays the logo inside the app and on the splash (mipmap/splash_logo). No
     monochrome layer, so themed-icon launchers show it in colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
