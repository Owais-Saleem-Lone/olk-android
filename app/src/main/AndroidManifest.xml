<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      For the ISBN scanner's viewfinder, and (because declaring it makes the system
      camera app require it) for taking a cover photo. Both ask at the moment the
      user taps the button. `required=false` keeps the app installable on devices
      without a camera, where both features fall back to typing.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Approximate location only, asked for when the user taps "Share my location"
      on their profile: "books near me" needs a neighbourhood, never a house.
      Fine location is deliberately not declared. `required=false` so devices
      without location hardware can still install the app.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
      Declared now because minSdk is 26 and FCM lands in v1. On Android 13+ this is a
      runtime permission the app must ask for; the prompt goes in with the push work,
      not before — asking for notifications on first launch, before the user knows
      what the app is, is the fastest way to get permanently denied.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OlkApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Olk.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Olk.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Supabase auth callback. Must match SupabaseClientFactory's
              DEEP_LINK_SCHEME / DEEP_LINK_HOST, and the URL has to be added to the
              Supabase dashboard's redirect allow-list or the link silently fails.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="olk"
                    android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!--
          Lets the system camera app write a cover photo into our cache
          (cover_paths.xml). No CAMERA permission is declared on purpose: the photo
          is taken by the camera app via ACTION_IMAGE_CAPTURE, which needs none
          as long as this app does not request the permission itself.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/cover_paths" />
        </provider>
    </application>

</manifest>
